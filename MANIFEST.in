include README.md ARCHITECTURE.md ROADMAP.md pyproject.toml .gitattributes .gitignore
include LICENSE NOTICE CONTRIBUTING.md
recursive-include docs *.md
recursive-include contracts *.json *.md
recursive-include tests *.py *.json
recursive-include tools *.py *.json
recursive-include src/quintessence_pcs/resources/migrations *.sql
global-exclude *.pyc *.sqlite *.sqlite3 *.db *.log
prune .git
