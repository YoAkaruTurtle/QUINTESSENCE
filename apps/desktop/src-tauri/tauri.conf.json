{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QUINTESSENCE",
  "version": "0.1.0",
  "identifier": "com.quintessence.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QUINTESSENCE · Consult",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "QUINTESSENCE desktop Consult",
    "longDescription": "A quiet, conversational Consult workspace over a fixed trusted PCS host and the desktop.v1 bridge.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
