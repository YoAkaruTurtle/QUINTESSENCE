{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "pcs.v2 Event envelope (J.2). event_seq is generated by the store and is deliberately not part of this envelope. source_kind is bound by the trusted entry point. Unknown top-level fields are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "event_id",
    "namespace",
    "source_kind",
    "source_instance",
    "source_event_id",
    "source_position",
    "event_type",
    "observed_at",
    "recorded_at",
    "payload_ref",
    "causation_refs",
    "privacy_class"
  ],
  "properties": {
    "protocol_version": {
      "$ref": "_common.json#/$defs/protocol_version"
    },
    "event_id": {
      "$ref": "_common.json#/$defs/uuid"
    },
    "namespace": {
      "$ref": "_common.json#/$defs/namespace"
    },
    "source_kind": {
      "$ref": "_common.json#/$defs/source_kind"
    },
    "source_instance": {
      "$ref": "_common.json#/$defs/instance_id"
    },
    "source_event_id": {
      "$ref": "_common.json#/$defs/source_event_id"
    },
    "source_position": {
      "$ref": "_common.json#/$defs/source_position"
    },
    "event_type": {
      "$ref": "_common.json#/$defs/event_type"
    },
    "observed_at": {
      "$ref": "_common.json#/$defs/nullable_timestamp_utc"
    },
    "recorded_at": {
      "$ref": "_common.json#/$defs/timestamp_utc"
    },
    "payload_ref": {
      "$ref": "_common.json#/$defs/payload_ref"
    },
    "causation_refs": {
      "type": "array",
      "description": "Explicit causal references; each element must be an EventRef or RecordRef, never a bare ID.",
      "items": {
        "$ref": "_common.json#/$defs/any_ref"
      },
      "uniqueItems": true
    },
    "privacy_class": {
      "$ref": "_common.json#/$defs/privacy_class"
    }
  }
}
